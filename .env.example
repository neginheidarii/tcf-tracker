# Copy to .env.local and fill in. Both values are safe to ship in a browser
# bundle: the publishable key only grants what row level security allows.
#
#   Supabase dashboard -> Project Settings -> API
#   Running locally    -> npm run db:start prints both

VITE_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
